# Koch Arm - Dynamixel U2D2 固定設備規則
# 
# 此規則將 Koch 手臂的 U2D2 介面固定為 /dev/ttyACM0
# 即使重新插拔 USB，設備名稱也不會改變
#
# 設備資訊:
#   - Vendor ID:  1a86
#   - Product ID: 55d3
#   - Serial:     5876042900
#
# 安裝方法:
#   sudo cp 99-koch-arm.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   
# 重新插拔 USB 後生效

# Koch Arm - 固定為 ttyACM0
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5876042900", SYMLINK+="ttyKochArm", MODE="0666", GROUP="dialout"

# 如果想要固定編號（需要確保沒有其他 ACM 設備）
KERNEL=="ttyACM*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5876042900", SYMLINK+="ttyACM0", MODE="0666", GROUP="dialout"
